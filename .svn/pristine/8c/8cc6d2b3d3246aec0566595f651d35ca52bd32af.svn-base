services:
  
  relay:
    build: .
    hostname: YOURDOMAIN.COM
    environment:
        #required settings:
      - RELAY_HOSTNAME=YOURDOMAIN.COM
      - RELAY_DOMAIN=YOURDOMAIN.COM
      - RELAY_USER_FILE=/run/secrets/relay_user
      - RELAY_PASSWORD_FILE=/run/secrets/relay_password
      - TLS_CERT_PATH=/certs/fullchain.pem
      - TLS_KEY_PATH=/certs/privkey.pem
        #only if INBOUND port 25 is blocked:
      - FORWARD_DOMAIN=YOURDOMAIN.COM
      - FORWARD_TARGET=mail.YOURDOMAIN.COM:2525
        #email queue settings - control vps email storage:
      - MAXIMAL_QUEUE_LIFETIME=3d
      - BOUNCE_QUEUE_LIFETIME=3d
      - MAXIMAL_BACKOFF_TIME=4000s
      - MINIMAL_BACKOFF_TIME=1000s
      - QUEUE_RUN_DELAY=1000s
        #IP whitelist for authentication - add your trusted IPs here - might not work because of your companies vps proxy:
      - TRUSTED_IPS=1.2.3.4 OK
    secrets:
      - relay_user
      - relay_password
    ports:
      - "25:25"
      - "465:465"
      - "587:587"
    volumes:
      - ./certs:/certs:ro
      - relay_state:/var/lib/postfix
      - sasl_db:/etc/sasl
    devices:
      - /dev/urandom:/dev/urandom:ro
    tmpfs:
      - /tmp
      - /var/run
    cap_drop: #for security: drop root capabilities
      - ALL
    cap_add: #for security: add required capablities
      - CHOWN
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
      - DAC_OVERRIDE
      - FOWNER
      - SETFCAP
      - SYS_CHROOT
    restart: unless-stopped
    networks:
      - mail_network
    deploy: #for security: limit resources
      resources:
        limits:
          memory: 512M
          cpus: '1.0'
        reservations:
          memory: 128M
          cpus: '0.1'
    ulimits: #for security: limit resources
      nproc: 100
      nofile: 1024
      memlock: 67108864

volumes:
  relay_state:
    driver: local
  sasl_db:
    driver: local

secrets:
  relay_user:
    file: ./secrets/relay_user.txt
  relay_password:
    file: ./secrets/relay_password.txt

networks:
  mail_network: #for security: isolate network
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16
