#this is connect to port 25 INBOUND - receiving mail
smtp      inet  n       -       n       -       -       smtpd
  -o smtpd_client_restrictions=permit_mynetworks,reject

#when port 587 is disabled, these lines can probably be removed.
#submission inet n       -       n       -       -       smtpd
#  -o syslog_name=postfix/submission
#  -o smtpd_tls_security_level=may
#  -o smtpd_sasl_auth_enable=yes

#this is connected to port 465 - SMTP over TLS with SASL auth and IP restrictions
smtps     inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_tls_cert_file=/certs/fullchain.pem
  -o smtpd_tls_key_file=/certs/privkey.pem
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_sasl_security_options=noanonymous
  -o smtpd_client_restrictions=permit_mynetworks,check_client_access,hash:/etc/postfix/whitelist,reject


#Core Postfix Services

#Queue Management
#qmgr - Queue manager (processes mail queue)
#pickup - Picks up local mail
#cleanup - Message cleanup and header processing
#flush - Forces queue flush

#Delivery Services
#relay - SMTP relay (sends mail to other servers)
#local - Local delivery
#virtual - Virtual mailbox delivery
#lmtp - Local Mail Transfer Protocol

#Error Handling
#bounce - Bounce message generation
#defer - Deferred message handling
#error - Error message generation
#retry - Retry failed deliveries

#Utility Services
#proxymap - Database lookup proxy
#tlsmgr - TLS session cache manager
#anvil - Rate limiting
#verify - Address verification
#showq - Queue display
#Mail Relay Service Flow

#Incoming Mail (Port 25) → smtpd → cleanup → qmgr → relay → External SMTP
#Outgoing Mail (Port 587) → submission → cleanup → qmgr → relay → External SMTP
#Encrypted Mail (Port 465) → smtps → cleanup → qmgr → relay → External SMTP

proxymap  unix  -       -       n       -       -       proxymap
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
anvil     unix  -       -       n       -       1       anvil
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
pickup    unix  n       -       n       60      1       pickup
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxywrite unix -       -       n       -       1       proxymap
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
scache    unix  -       -       n       -       1       scache


